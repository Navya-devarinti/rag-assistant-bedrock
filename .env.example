# Copy this file to .env and fill in your values. Never commit .env.
# AWS credentials are read from the environment by boto3 (or from this file);
# never hardcode them in source code.

# AWS region where Bedrock is available, e.g. us-east-1
AWS_REGION=us-east-1

# Bedrock model IDs (change these if a model is unavailable in your region)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional overrides (defaults shown)
# RAG_DATA_DIR=data
# RAG_INDEX_DIR=faiss_index
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=4
# RAG_TEMPERATURE=0.0
